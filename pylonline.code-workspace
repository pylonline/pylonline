{
  "folders": [
    { "path": ".", "name": "pylonline" },
    { "path": "core-ui", "name": "core-ui" },
    { "path": "portal", "name": "portal" },
    { "path": "pylon", "name": "pylon" },
    { "path": "core-lint", "name": "core-lint" },
    { "path": "docs", "name": "docs" },
    { "path": "scripts", "name": "scripts" }
  ],
  "settings": {
    "workbench.colorTheme": "Quiet Light",
    "files.autoSave": "onFocusChange",
    "git.autoRepositoryDetection": "subFolders",
    "git.detectSubmodules": true,
    "npm.packageManager": "pnpm",
    "npm.scriptRunner": "pnpm",
    "files.exclude": {
      "**/node_modules": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.generated": true,
      "pnpm-lock.yaml": true
    },
    "eslint.workingDirectories": [{ "mode": "auto" }],
    "eslint.options": { "overrideConfigFile": "config/eslint.config.mjs" },
    "prettier.configPath": "config/prettier.config.cjs",
    "prettier.ignorePath": "config/.prettierignore",
    "stylelint.configFile": "config/stylelint.config.cjs",
    "stylelint.validate": ["css"],
    "css.validate": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "stylelint.vscode-stylelint"
    ]
  }
}
