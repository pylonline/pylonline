  "cards": [
    {
      "dot": "cyan",
      "title": "HTTP planes",
      "items": [
        "public :8788 and private :8790 share the main host; privileged :8789 is admin.* and requires Cloudflare Access",
        "core-ui assets ship from each browser Worker ASSETS binding; there is no product Worker"
      ]
    },
    {
      "dot": "emerald",
      "title": "Owner D1s",
      "items": [
        "dbFor never falls back to env.DB; public/private/privileged bind product only and hop other domains",
        "Billing writes entitlements through the installation queue; private applies those jobs to product D1"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Identity, billing, dispatcher, and logger have no public DNS; hops use x-hop-assertion (Ed25519) plus HopReplayGuard",
        "Stripe and Resend webhooks hit public /api/webhooks/* and forward raw bytes to the owner Worker"
      ]
    },
    {
      "dot": "amber",
      "title": "Not on the main path",
      "items": [
        "Monitor (mTLS, Pylon enroll), logger (tail → worker_log_events), and status (maintenance board) hop from the HTTP planes",
        "Pylon desktop nodes call monitor; OTP generation stays on identity while dispatcher only delivers"
      ]
    }
  ]
